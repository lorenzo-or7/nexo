+/* --------------------------------------------------------------------------
+   Página inicial pública
+   -------------------------------------------------------------------------- */
+@media (prefers-reduced-motion: no-preference) {
+  html:has([data-landing]) {
+    scroll-behavior: smooth;
+  }
+}
+
+/* entrada ao rolar: só opacidade e transform; sem JS o conteúdo fica visível */
+.reveal {
+  transition: opacity 650ms cubic-bezier(0.2, 0.7, 0.2, 1), transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
+}
+.reveal[data-reveal="armed"] {
+  opacity: 0;
+  transform: translateY(18px);
+}
+
+/* controle deslizante do simulador */
+.sim-range {
+  -webkit-appearance: none;
+  appearance: none;
+  width: 100%;
+  height: 1.75rem;
+  background: transparent;
+  cursor: pointer;
+}
+.sim-range::-webkit-slider-runnable-track {
+  height: 6px;
+  border-radius: 999px;
+  background: linear-gradient(to right, var(--tone) var(--pct), var(--surface-3) var(--pct));
+}
+.sim-range::-moz-range-track {
+  height: 6px;
+  border-radius: 999px;
+  background: linear-gradient(to right, var(--tone) var(--pct), var(--surface-3) var(--pct));
+}
+.sim-range::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  appearance: none;
+  margin-top: -8px;
+  width: 22px;
+  height: 22px;
+  border-radius: 999px;
+  background: #fff;
+  border: 3px solid var(--tone);
+  box-shadow: 0 2px 8px rgb(0 0 0 / 0.3);
+}
+.sim-range::-moz-range-thumb {
+  width: 16px;
+  height: 16px;
+  border-radius: 999px;
+  background: #fff;
+  border: 3px solid var(--tone);
+  box-shadow: 0 2px 8px rgb(0 0 0 / 0.3);
+}
+.sim-range:focus-visible {
+  outline: 2px solid var(--focus);
+  outline-offset: 4px;
+  border-radius: 999px;
+}
